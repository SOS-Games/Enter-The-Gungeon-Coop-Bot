<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CoopBot.local.props" Condition="Exists('CoopBot.local.props')" />

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CoopBot</AssemblyName>
    <RootNamespace>CoopBot</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- Set your own paths in CoopBot.local.props (git-ignored; copy CoopBot.local.props.example) or on the command line: dotnet build -p:GamePath="..." -p:BepInExPath="..." -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Enter the Gungeon</GamePath>
    <!-- BepInEx lives in the r2modman profile, not the game folder. -->
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(GamePath)\BepInEx</BepInExPath>
    <ManagedPath>$(GamePath)\EtG_Data\Managed</ManagedPath>
    <PluginDir>$(BepInExPath)\plugins\CoopBot</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedPath)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(ManagedPath)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExPath)')">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(OutputPath)CoopBot.dll" DestinationFolder="$(PluginDir)" />
  </Target>

</Project>
